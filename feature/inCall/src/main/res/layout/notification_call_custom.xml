<?xml version="1.0" encoding="utf-8"?>
<!--
    来电横幅的自定义布局（heads-up）。

    为什么不用系统 CallStyle：它的 heads-up 只有四个固定槽位
    （person.name / callType / appName / time），person.name 实测只剩 3 个汉字宽度，
    setSubText 会被完全忽略，标签塞不进去。

    所以自己画：左边两行文字（号码 + 标签），右边红/绿圆按钮。
    文字颜色由 RemoteViews 按深浅色主题动态设置，这里不写死。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/call_custom_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/call_custom_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:alpha="0.75" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/call_custom_decline"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_call_decline"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_call_decline"
        android:contentDescription="@string/action_decline" />

    <ImageButton
        android:id="@+id/call_custom_answer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_call_answer"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_call_answer"
        android:contentDescription="@string/action_answer" />

</LinearLayout>
