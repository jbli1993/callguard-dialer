<?xml version="1.0" encoding="utf-8"?>
<!--
    来电横幅的自定义布局（collapsed / heads-up）。

    为什么不用系统 CallStyle：它的 heads-up 只有四个固定槽位
    （person.name / callType / appName / time），person.name 实测只剩 3 个汉字宽度，
    setSubText 会被完全忽略，标签塞不进去。

    高度预算：Android 2025 通知模板给 collapsed 自定义内容的可用高度是 48dp
    （notification_2025_template_collapsed_base.xml 的注释明确写了这一点）。
    所以这里根布局固定 48dp，按钮也是 48dp，上下不再加额外 padding；
    否则折叠进通知栏时，圆形按钮会被系统上下裁剪。
    展开态使用 notification_call_custom_large.xml，高度更宽松。

    文字颜色由 RemoteViews 按深浅色主题动态设置，这里不写死。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/call_custom_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/call_custom_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="@android:color/black"
            android:alpha="0.75" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/call_custom_decline"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_call_decline"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_call_decline"
        android:contentDescription="@string/action_decline" />

    <ImageButton
        android:id="@+id/call_custom_answer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_call_answer"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_call_answer"
        android:contentDescription="@string/action_answer" />

</LinearLayout>
